{
  "name": "metallmontage33",
  "version": "2.0.0",
  "private": true,
  "description": "Металл Монтаж 33 — Next.js static export landing page",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "serve out -l 3000",
    "preview": "serve out -l 3000",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.playwright.json",
    "lint": "eslint . --max-warnings 0 && stylelint \"styles/**/*.css\" --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0 && stylelint \"styles/**/*.css\" --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "test:a11y": "playwright test --project=a11y",
    "test:cross-browser": "playwright test --project=firefox --project=webkit",
    "test:visual": "playwright test --project=visual",
    "validate": "node ./scripts/validate-out.mjs",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run validate",
    "postbuild": "node ./scripts/patch-sw-precache.mjs"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.7",
    "serve": "^14.2.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
